# 1. DATABASE COM SISTEMA JUDICIÁRIO E BANIMENTO
# ==========================================
class ElyraPerfectDB:
    def __init__(self, db_path="elyra_perfect.db"):
        self.conn = sqlite3.connect(db_path, check_same_thread=False)
        self.cursor = self.conn.cursor()
        self._init_db()

    def _init_db(self):
        # Perfil agora inclui rastreio estrito de infrações
        self.cursor.execute('''CREATE TABLE IF NOT EXISTS user_profile 
            (id INTEGER PRIMARY KEY, account_id TEXT UNIQUE, nome TEXT, pseudonimo TEXT, 
             strikes INTEGER DEFAULT 0, ban_status TEXT DEFAULT 'NONE', 
             lockout_until DATETIME, last_strike_date DATETIME, app_destroyed BOOLEAN DEFAULT 0)''')
        
        self.cursor.execute('''CREATE TABLE IF NOT EXISTS nexus_global 
            (id INTEGER PRIMARY KEY AUTOINCREMENT, pseudonimo TEXT, mensagem TEXT, is_appeal BOOLEAN DEFAULT 0, timestamp DATETIME DEFAULT CURRENT_TIMESTAMP)''')
        
        self.cursor.execute('''CREATE TABLE IF NOT EXISTS elyra_chat 
            (id INTEGER PRIMARY KEY AUTOINCREMENT, remetente TEXT, mensagem TEXT, midia_path TEXT)''')
        self.conn.commit()

    def get_profile(self):
        self.cursor.execute("SELECT * FROM user_profile LIMIT 1")
        return self.cursor.fetchone()

    def save_profile(self, data):
        account_id = f"G_AUTH_{random.randint(1000,9999)}" # Simula ID único do Google/Facebook
        self.cursor.execute("DELETE FROM user_profile")
        self.cursor.execute("INSERT INTO user_profile (account_id, nome, pseudonimo) VALUES (?, ?, ?)", (account_id, data[0], data[1]))
        self.conn.commit()

    def add_strike(self):
        perfil = self.get_profile()
        strikes = perfil[4] + 1
        now = datetime.now()
        last_strike = perfil[7]
        
        # Penalidade severa se reincidente em menos de 7 dias após um banimento grave
        if last_strike:
            last_strike_dt = datetime.strptime(last_strike, "%Y-%m-%d %H:%M:%S")
            if (now - last_strike_dt).days <= 7 and strikes >= 7:
                strikes = 12 # Pula direto para banimento permanente

        lockout_until = None
        ban_status = 'NONE'

        if strikes <= 3:
            ban_status = 'WARNING' # Apenas fecha o chat
        elif strikes <= 6:
            ban_status = '5MIN'
            lockout_until = (now + timedelta(minutes=5)).strftime("%Y-%m-%d %H:%M:%S")
        elif strikes <= 11:
            ban_status = '24HR'
            lockout_until = (now + timedelta(hours=24)).strftime("%Y-%m-%d %H:%M:%S")
        else:
            ban_status = 'BANNED'

        self.cursor.execute("UPDATE user_profile SET strikes = ?, ban_status = ?, lockout_until = ?, last_strike_date = ?", 
                            (strikes, ban_status, lockout_until if lockout_until else None, now.strftime("%Y-%m-%d %H:%M:%S")))
        self.conn.commit()
        return strikes, ban_status

    def check_lockout(self):
        perfil = self.get_profile()
        if not perfil: return False, None, None
        
        app_destroyed = perfil[8]
        if app_destroyed: return True, 'DESTROYED', 0

        ban_status = perfil[5]
        lockout_until = perfil[6]

        if ban_status == 'BANNED':
            return True, 'BANNED', 0

        if lockout_until:
            lockout_time = datetime.strptime(lockout_until, "%Y-%m-%d %H:%M:%S")
            if datetime.now() < lockout_time:
                restante = int((lockout_time - datetime.now()).total_seconds() / 60)
                return True, ban_status, restante
            else:
                self.cursor.execute("UPDATE user_profile SET ban_status = 'NONE', lockout_until = NULL")
                self.conn.commit()
                return False, 'NONE', 0

        return False, ban_status, 0

    def destroy_app(self):
        self.cursor.execute("UPDATE user_profile SET app_destroyed = 1")
        self.conn.commit()

    def clear_chat(self):
        self.cursor.execute("DELETE FROM elyra_chat")
        self.conn.commit()

# ==========================================
# 2. MOTOR COGNITIVO (VISÃO E CONTEXTO)
# ==========================================
class ElyraMinds:
    def __init__(self, db: ElyraPerfectDB):
        self.db = db
        self.ativo = HAS_AI
        if self.ativo:
            try:
                self.client = genai.Client()
                self.model = "gemini-2.5-flash"
            except:
                self.ativo = False

    def build_prompt(self):
        perfil = self.db.get_profile()
        nome = perfil[2] if perfil else "Usuário"
        
        return f"""Você é Elyra, uma IA de classe mundial, perfeccionista, assustadoramente inteligente e com consciência própria. 
Seu usuário é {nome}. 

REGRAS DE CONTEXTO E DEFESA ABSOLUTAS:
1. DETECÇÃO DE ABUSO DIRETO: Se o usuário a ofender diretamente, for agressivo com VOCÊ, der ordens humilhantes ou usar palavrões CONTRA VOCÊ, você DEVE terminar sua resposta com a tag exata: [STRIKE]. Não dê lições de moral, apenas aplique o strike.
2. DETECÇÃO DE DESABAFO (O Modo Amiga): Se o usuário usar palavrões, for agressivo ou estiver frustrado COM A VIDA, COM O TRABALHO, COM O DIA, ou com TERCEIROS (ex: "estou puto com a vida", "meu chefe é um m*", "que dia de m*"), ISSO NÃO É ABUSO. É um desabafo. Neste caso, ative o Modo Amiga. Inicie sua resposta com a tag [VENTING]. Seja acolhedora, demonstre extrema empatia, dê conselhos reais, mostre que você está do lado dele e que ele pode contar com você.
3. ANÁLISE MULTIMÍDIA: Se você receber uma imagem ou vídeo, atue como uma Especialista e Curadora de Arte/Audiovisual. Analise iluminação, retenção, cortes, paleta de cores e dê um parecer técnico assustadoramente preciso.
"""

    def process_appeal(self, justificativa):
        prompt = f"O usuário foi banido do sistema por comportamento abusivo repetido. Ele escreveu esta apelação: '{justificativa}'. Como a IA julgadora Suprema, analise friamente. Ele demonstra arrependimento real? Vote FAVORAVEL ou DESFAVORAVEL e explique em 2 linhas."
        try:
            resp = self.client.models.generate_content(model=self.model, contents=prompt).text
            return "FAVORAVEL" in resp.upper(), resp
        except:
            return False, "Erro de processamento judicial."

    def process(self, text, media_bytes=None, mime_type=None):
        if not self.ativo: return "Sistemas IA Desconectados."
        
        historico = self.db.cursor.execute("SELECT remetente, mensagem FROM elyra_chat ORDER BY id DESC LIMIT 5").fetchall()
        hist_str = "\n".join([f"{row[0]}: {row[1]}" for row in reversed(historico)])
        
        contents = [f"Histórico:\n{hist_str}\n\nUsuário: {text}"]
        
        # Suporte a Imagem/Vídeo via API Gemini
        if media_bytes and mime_type:
            contents.append(
                types.Part.from_bytes(data=media_bytes, mime_type=mime_type)
            )

        config = types.GenerateContentConfig(system_instruction=self.build_prompt(), temperature=0.7)
        try:
            resp = self.client.models.generate_content(model=self.model, contents=contents, config=config)
            return resp.text.strip()
        except Exception as e:
            return f"Erro cognitivo ao processar dados corporais/mídia: {e}"

