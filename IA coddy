        btn_apelar = ft.ElevatedButton("SUBMETER AO TRIBUNAL", bgcolor=C_WARNING, color=ft.colors.WHITE)

        def apelar(e):
            if not justificativa.value: return
            btn_apelar.visible = False
            console.controls.append(ft.Text("> Enviando dados para o Nexus Global...", color=ft.colors.WHITE54))
            page.update()

            def julgamento():
                time.sleep(2)
                console.controls.append(ft.Text("> Comunidade Nexus votando... (Anonimizado)", color=C_NEXUS))
                page.update()
                time.sleep(3)
                
                voto_nexus = random.choice([True, False, False]) # Comunidade costuma ser rígida
                console.controls.append(ft.Text(f"> Veredicto da Comunidade: {'PERDOAR' if voto_nexus else 'MANTER BAN'}", color=C_NEXUS if voto_nexus else C_WARNING))
                page.update()
                time.sleep(2)

                console.controls.append(ft.Text("> IA Elyra analisando sinceridade...", color=C_ELYRA))
                page.update()
                aprovado_ia, exp_ia = ai.process_appeal(justificativa.value)
                console.controls.append(ft.Text(f"> Veredicto IA: {'PERDOAR' if aprovado_ia else 'MANTER BAN'} - {exp_ia}", color=C_ELYRA if aprovado_ia else C_WARNING))
                page.update()
                time.sleep(3)

                # Decisão Final
                if aprovado_ia or voto_nexus:
                    console.controls.append(ft.Text(">> TRIBUNAL DEFERE APELAÇÃO. Bloqueio levantado.", color=ft.colors.GREEN))
                    db.cursor.execute("UPDATE user_profile SET strikes = 0, ban_status = 'NONE'")
                    db.conn.commit()
                    page.update()
                    time.sleep(2)
                    load_core()
                else:
                    console.controls.append(ft.Text(">> TRIBUNAL INDEFERE APELAÇÃO. Iniciando protocolo de autodestruição.", color=C_WARNING))
                    db.destroy_app()
                    page.update()
                    time.sleep(3)
                    page.clean()
                    page.add(view_destroyed())
                    page.update()

            threading.Thread(target=julgamento).start()

        btn_apelar.on_click = apelar

        return ft.Container(
            content=ft.Column([
                ft.Icon(ft.icons.GAVEL, color=C_WARNING, size=60),
                ft.Text("SISTEMA BLOQUEADO. BANIMENTO PERMANENTE.", size=16, weight="bold", color=C_WARNING, font_family="Syncopate", text_align="center"),
