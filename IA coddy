    # ==========================================
    # VIEW: CHAT & MEDIA (O Núcleo)
    # ==========================================
    def view_chat():
        lista_msgs = ft.ListView(expand=True, spacing=15, auto_scroll=True)
        entrada = ft.TextField(expand=True, hint_text="Digite ou envie mídia...", border_radius=20, bgcolor=C_SURFACE, border_color="#333333")
        indicador = ft.Text("Elyra está processando...", size=12, color=ft.colors.WHITE54, italic=True, visible=False)
        midia_selecionada = ft.Text("", size=10, color=C_ELYRA)
        midia_cache = {"bytes": None, "mime": None}

        def on_file_picked(e: ft.FilePickerResultEvent):
            if e.files and len(e.files) > 0:
                f = e.files[0]
                midia_selecionada.value = f"Mídia Anexada: {f.name}"
                mime = "video/mp4" if f.name.endswith(('.mp4', '.mov')) else "image/jpeg"
                with open(f.path, "rb") as file:
                    midia_cache["bytes"] = file.read()
                midia_cache["mime"] = mime
                page.update()
        
        file_picker.on_result = on_file_picked

        def add_bubble(remetente, texto, is_venting=False):
            is_user = remetente != "Elyra"
            cor_bg = "#1A1A1A" if is_user else ("#1A2B3C" if is_venting else C_SURFACE)
            cor_txt = ft.colors.WHITE if is_user else (C_NEXUS if is_venting else C_ELYRA)
            
            buble = ft.Container(
                content=ft.Column([
                    ft.Text(remetente + (" (Modo Amiga Ativado)" if is_venting else ""), size=10, color=cor_txt, weight="bold"),
                    ft.Text(texto, color=ft.colors.WHITE, size=14)
                ]),
                bgcolor=cor_bg, padding=15, border_radius=15, max_width=320,
                border=ft.border.all(1, ft.colors.TRANSPARENT if is_user else "#222")
            )
            lista_msgs.controls.append(ft.Row([buble], alignment=ft.MainAxisAlignment.END if is_user else ft.MainAxisAlignment.START))
            db.cursor.execute("INSERT INTO elyra_chat (remetente, mensagem) VALUES (?, ?)", (remetente, texto))
            db.conn.commit()
            page.update()

        def enviar(e):
            msg = entrada.value.strip()
            if not msg and not midia_cache["bytes"]: return
            entrada.value = ""
            midia_selecionada.value = ""
            
            txt_user = msg if msg else "[Mídia Enviada]"
            add_bubble("Você", txt_user)
            
            indicador.visible = True
            page.update()

            def processar():
                resp = ai.process(msg, midia_cache["bytes"], midia_cache["mime"])
                midia_cache["bytes"], midia_cache["mime"] = None, None # Limpa cache
                indicador.visible = False
                
                # --- SISTEMA DE JULGAMENTO DE CONTEXTO ---
                if "[VENTING]" in resp:
                    # O usuário desabafou. Elyra vira a melhor amiga.
                    resp_limpa = resp.replace("[VENTING]", "").strip()
                    add_bubble("Elyra", resp_limpa, is_venting=True)
                
                elif "[STRIKE]" in resp:
                    # Abuso detectado contra a IA
                    strikes, status = db.add_strike()
                    if strikes <= 3:
                        # Punição Nível 1: Encerra o chat abruptamente
                        db.clear_chat()
                        lista_msgs.controls.clear()
                        lista_msgs.controls.append(ft.Text(f"SISTEMA DE DEFESA ATIVADO. Chat encerrado. Infração {strikes}/3. Próxima infração resultará em bloqueio do aplicativo.", color=C_WARNING, weight="bold", text_align="center"))
                        page.update()
                    else:
                        # Punição Nível 2+: Redireciona para tela de castigo ou banimento
                        load_core() 
                else:
                    # Fluxo Normal
                    add_bubble("Elyra", resp)
            
            threading.Thread(target=processar).start()

        # Carrega histórico recente visual
        for r, m in db.cursor.execute("SELECT remetente, mensagem FROM elyra_chat").fetchall():
            add_bubble(r, m)

        return ft.Column([
            ft.Row([ft.Text("ELYRA OS", font_family="Syncopate", weight="bold", color=C_ELYRA), ft.Container(expand=True), ft.Icon(ft.icons.LENS, color=C_NEXUS, size=10)]),
            ft.Divider(color="#222"),
            ft.Container(content=lista_msgs, expand=True),
            midia_selecionada,
            indicador,
            ft.Row([
                ft.IconButton(ft.icons.ATTACH_FILE, on_click=lambda _: file_picker.pick_files(allow_multiple=False)),
                entrada, 
                ft.IconButton(ft.icons.SEND, icon_color=C_ELYRA, on_click=enviar)
            ])
        ], padding=20)

